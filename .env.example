# Copernicus Data Space Ecosystem (CDSE) credentials.
# Create at https://dataspace.copernicus.eu/ and never commit the real .env.
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=

# Sentinel Hub instance for Processing API (basemap composites + previews).
SH_INSTANCE_ID=

# --- Optional ---

# Set to true to log raw AOI polygon coordinates (default redacts them via a hash).
LOG_AOI=false

# Set to true to append a JSONL audit log of CDSE queries / cache hits / exports.
AUDIT_LOG_ENABLED=false

# Network-level protection (Tor, VPN). httpx honors these automatically.
HTTPS_PROXY=
ALL_PROXY=
